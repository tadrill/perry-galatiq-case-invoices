# xAI Grok API. Get a key at https://console.x.ai
# Leave LLM_MODE=mock to run the full pipeline with no key and no network.
XAI_API_KEY=

# Base URL for the xAI API (OpenAI-compatible).
XAI_BASE_URL=https://api.x.ai/v1

# Model id. grok-4.6 is the current flagship (500k context, tool calling,
# structured outputs). Pin whatever your key has access to.
GROK_MODEL=grok-4.6

# grok | mock  -- "mock" replays deterministic canned responses so the
# pipeline runs end-to-end offline, per the "no internet" requirement.
LLM_MODE=grok

# Paths
DB_PATH=inventory.db
INVOICE_DIR=data/invoices
